<Window x:Class="Asterion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asterion Observatory" Height="920" Width="1540" MinHeight="720" MinWidth="1120"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#19232F" />
            <Setter Property="BorderBrush" Value="#2B3948" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="116" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="12" Background="#152B31" BorderBrush="#284943" BorderThickness="1">
                    <TextBlock Text="✦" Foreground="{StaticResource AccentBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ASTERION" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="OBSERVATORY  /  LIVE IMAGING" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="10" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}" Padding="12,8" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#E0A76B" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="ConnectionLabel" Text="SDK NOT CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#E0B47D" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource ActionButton}" Content="Settings" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="540" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="LIVE VIEW" Style="{StaticResource SectionLabel}" Margin="0,0,0,0" />
                        <TextBlock Text="Camera preview" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button x:Name="ScreenshotButton" Style="{StaticResource ActionButton}" Content="Save current frame" IsEnabled="False" Click="ScreenshotButton_Click" Margin="0,0,8,0" />
                        <Button x:Name="SnapshotButton" Style="{StaticResource ActionButton}" Content="Capture image" IsEnabled="False" Click="SnapshotButton_Click" Margin="0,0,8,0" />
                        <Button x:Name="RecordButton" Style="{StaticResource ActionButton}" Content="Record SER" IsEnabled="False" Click="RecordButton_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource PanelCard}" Background="#06090E" ClipToBounds="True">
                    <Grid>
                        <Grid.Background>
                            <RadialGradientBrush Center="0.52,0.48" GradientOrigin="0.52,0.48" RadiusX="0.82" RadiusY="0.82">
                                <GradientStop Color="#101A25" Offset="0" />
                                <GradientStop Color="#080C12" Offset="0.72" />
                                <GradientStop Color="#06090E" Offset="1" />
                            </RadialGradientBrush>
                        </Grid.Background>
                        <Canvas IsHitTestVisible="False" Opacity="0.58">
                            <Ellipse Canvas.Left="96" Canvas.Top="84" Width="2" Height="2" Fill="#E6EFF7" />
                            <Ellipse Canvas.Left="220" Canvas.Top="168" Width="1.5" Height="1.5" Fill="#A6C9D8" />
                            <Ellipse Canvas.Left="410" Canvas.Top="72" Width="2" Height="2" Fill="#F0E7D2" />
                            <Ellipse Canvas.Left="588" Canvas.Top="122" Width="1.5" Height="1.5" Fill="#E6EFF7" />
                            <Ellipse Canvas.Left="760" Canvas.Top="196" Width="2" Height="2" Fill="#C8D6E5" />
                            <Ellipse Canvas.Left="172" Canvas.Top="354" Width="2" Height="2" Fill="#D7E8F0" />
                            <Ellipse Canvas.Left="350" Canvas.Top="296" Width="1.5" Height="1.5" Fill="#F1DEBA" />
                            <Ellipse Canvas.Left="612" Canvas.Top="382" Width="2" Height="2" Fill="#AAC8D4" />
                            <Ellipse Canvas.Left="822" Canvas.Top="330" Width="1.5" Height="1.5" Fill="#E6EFF7" />
                            <Ellipse Canvas.Left="910" Canvas.Top="100" Width="2" Height="2" Fill="#D5DDEC" />
                            <Ellipse Canvas.Left="474" Canvas.Top="456" Width="1.5" Height="1.5" Fill="#E6EFF7" />
                            <Ellipse Canvas.Left="1000" Canvas.Top="422" Width="2" Height="2" Fill="#C5D7E2" />
                            <Line X1="0" Y1="0" X2="1200" Y2="620" Stroke="#172332" StrokeThickness="1" Opacity="0.22" />
                        </Canvas>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                        <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Width="370">
                            <Border Width="54" Height="54" CornerRadius="18" BorderBrush="#293847" BorderThickness="1" Background="#111A24" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <TextBlock Text="◉" FontSize="25" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Your sky, in focus." FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PreviewMessage" Text="The camera connection layer is being added. Once connected, your live ASI120MC view will appear here." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="13" LineHeight="21" Margin="0,10,0,0" />
                            <Border CornerRadius="8" Background="#121D27" BorderBrush="#263442" BorderThickness="1" Padding="11,8" HorizontalAlignment="Center" Margin="0,18,0,0">
                                <TextBlock Text="AI vision will inspect the live frame and can request a sharper capture" FontSize="11" Foreground="#A7BBC7" />
                            </Border>
                        </StackPanel>
                        <Border CornerRadius="8" Background="#0B1219" BorderBrush="#1E2B37" BorderThickness="1" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
                            <TextBlock Text="NO FRAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
                            <TextBlock Text="— fps" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,18,0" />
                            <TextBlock Text="0 dropped" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <TextBlock x:Name="StatusMessage" Text="Camera support is not connected in this build." Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="FrameInfo" Text="MCP CAMERA BRIDGE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource PanelCard}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="CAMERA" Style="{StaticResource SectionLabel}" />
                        <TextBlock x:Name="CameraName" Text="No camera selected" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="CameraModel" Text="ZWO ASI camera" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,16" />
                        <Button x:Name="ConnectButton" Style="{StaticResource ActionButton}" Content="Find and connect camera" Click="ConnectButton_Click" HorizontalContentAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ACQUISITION" Style="{StaticResource SectionLabel}" />
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Exposure" VerticalAlignment="Center" />
                            <TextBlock Text="ms" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="ExposureSlider" Minimum="0" Maximum="100" Value="50" IsEnabled="False" ValueChanged="ExposureSlider_ValueChanged" />
                        <TextBlock x:Name="ExposureValue" Text="— ms" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" />
                        <Grid Margin="0,15,0,12">
                            <TextBlock Text="Gain" VerticalAlignment="Center" />
                            <TextBlock Text="ASI120MC range" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" />
                        </Grid>
                        <Slider x:Name="GainSlider" Minimum="0" Maximum="100" Value="50" IsEnabled="False" ValueChanged="GainSlider_ValueChanged" />
                        <TextBlock x:Name="GainValue" Text="—" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" />
                        <Button x:Name="AutoExposureButton" Style="{StaticResource ActionButton}" Content="Auto exposure" IsEnabled="False" Click="AutoExposureButton_Click" Margin="0,12,0,0" HorizontalContentAlignment="Center" />
                        <Button x:Name="FastPreviewButton" Style="{StaticResource ActionButton}" Content="Fast preview · 33 ms / RAW8 / 2×" IsEnabled="False" Click="FastPreviewButton_Click" Margin="0,7,0,0" HorizontalContentAlignment="Center" />
                        <Grid Margin="0,15,0,8"><TextBlock Text="Binning" VerticalAlignment="Center" /><ComboBox x:Name="BinningCombo" Width="90" HorizontalAlignment="Right" IsEnabled="False" SelectionChanged="FormatSelection_Changed" /></Grid>
                        <Grid Margin="0,0,0,8"><TextBlock Text="Pixel format" VerticalAlignment="Center" /><ComboBox x:Name="PixelFormatCombo" Width="90" HorizontalAlignment="Right" IsEnabled="False" SelectionChanged="FormatSelection_Changed" /></Grid>
                        <Separator Margin="0,18,0,14" Background="#273442" />
                        <Grid>
                            <TextBlock Text="Frame format" VerticalAlignment="Center" />
                            <TextBlock Text="Auto" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="OBSERVATION ASSIST" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Live image understanding" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Live frames include brightness, highlight-clipping, focus, and bright-point metrics. MCP can suggest a bounded exposure adjustment without applying it; the AI client can inspect the image and request a follow-up capture. Time, location, and mount coordinates improve object identification." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" LineHeight="19" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource PanelCard}" Padding="18,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SESSION" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" />
                    <TextBlock Text="No capture session yet" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Captured images, settings, and observation notes will be collected together." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="AI CONTROL" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="Local MCP tools · user-visible camera state" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>


